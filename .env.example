# Echo Server / Conduit - environment template
# Copy to `.env` for local use (DO NOT COMMIT `.env`) or set these in Render → Environment.
# Rotate any token that was ever exposed before using it.

# --- Required ---
CONDUIT_SERVER_NAME=your-domain-or-render-hostname

# --- Database (Turso / libSQL - persistent) ---
CONDUIT_DATABASE_BACKEND=turso
CONDUIT_TURSO_URL=libsql://echo-matrix-preetb.aws-ap-south-1.turso.io
CONDUIT_TURSO_AUTH_TOKEN=__ROTATED_TURSO_AUTH_TOKEN__

# Local ancillary path (writable). Render maps PORT->CONDUIT_PORT via docker/entrypoint.sh.
CONDUIT_DATABASE_PATH=/var/lib/matrix-conduit

# --- Lockdown / registration (Step 1/2) ---
# For initial Step 1 persistence test, temporarily set ALLOW_REGISTRATION=true and provide a strong token.
CONDUIT_ALLOW_REGISTRATION=true
CONDUIT_REGISTRATION_TOKEN=__STRONG_REGISTRATION_TOKEN__
CONDUIT_ALLOW_FEDERATION=false

# --- Media (chunked + encrypted in the main Turso database) ---
# Files are split into chunks, encrypted with AES-256-GCM under a per-file key
# derived from this master key, and stored in the main Turso DB (`media_chunks`
# table) with per-chunk SHA-256 hashes. Media untouched for 30 days is purged.
# Generate once with: openssl rand -hex 32
CONDUIT_MEDIA_BACKEND=turso
CONDUIT_MEDIA_MASTER_KEY=__64_HEX_MASTER_KEY__
# Optional; default 512 KiB:
# CONDUIT_MEDIA_CHUNK_SIZE="512 KiB"

# --- Optional ---
# CONDUIT_CONFIG=/path/to/conduit.toml   # optional when unset/empty (env/defaults used)
# CONDUIT_LOG=info
# CONDUIT_MAX_REQUEST_SIZE=20000000

# --- TURN (Step 6, 1:1 calls) - add when ready ---
# CONDUIT_TURN_URIS=["turn:standard.relay.metered.ca:80?transport=udp","turn:standard.relay.metered.ca:80?transport=tcp","turns:standard.relay.metered.ca:443?transport=tcp"]
# CONDUIT_TURN_USERNAME=__METERED_USERNAME__
# CONDUIT_TURN_PASSWORD=__METERED_PASSWORD__
# Do NOT set CONDUIT_TURN_SECRET for Metered username/password mode.
